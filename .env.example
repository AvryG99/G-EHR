# Select "local" for DuckDB, or "cloud" to query BigQuery directly.
MIMIC_ENV=cloud
MIMIC_LOCAL_DB=mimiciii.duckdb

# Required only when MIMIC_ENV=cloud.
BIGQUERY_PROJECT=

# Dataset ID may be dataset or data-project.dataset (separate billing project).
BIGQUERY_DATASET=
# Optional dataset region, e.g. US.
BIGQUERY_LOCATION=
BIGQUERY_MAXIMUM_BYTES_BILLED=12000000000

OPENAI_API=
HUGGINGFACE_HUB_TOKEN=

# Save generated SQL prompts; debug also prints prompts, SQL and results.
MIMIC_PROMPT_LOG=logs/sql_prompts.jsonl
MIMIC_DEBUG=0
# Result review is enabled by default. Set 0 for a baseline without review.
# Each value is the maximum semantic SQL revisions (allowed: 0, 1, 2).
MIMIC_SEMANTIC_RETRIES=2

BIGQUERY_NOTES_DATASET=physionet-data.mimiciii_notes

# Queries referencing noteevents or chartevents may scan up to 30 GB.
BIGQUERY_LARGE_TABLE_MAXIMUM_BYTES_BILLED=30000000000
