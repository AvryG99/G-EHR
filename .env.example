# Select "local" to stop after DuckDB validation, or "cloud" to validate
# locally and then execute on BigQuery.
MIMIC_ENV=local
MIMIC_LOCAL_DB=mimic4.duckdb

# Required only when MIMIC_ENV=cloud.
BIGQUERY_PROJECT=
BIGQUERY_DATASET=
BIGQUERY_MAXIMUM_BYTES_BILLED=1000000000

OPENAI_API=
HUGGINGFACE_HUB_TOKEN=
